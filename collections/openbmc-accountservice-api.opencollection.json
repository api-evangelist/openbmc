{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenBMC Redfish AccountService API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "AccountService",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update the root account",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{bmc}/redfish/v1/AccountService/Accounts/root",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Modifies the root account, for example to change the password."
        }
      ]
    }
  ],
  "bundled": true
}