{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenBMC Redfish AccountService Chassis API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Chassis",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List chassis objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{bmc}/redfish/v1/Chassis"
          },
          "docs": "List chassis objects"
        }
      ]
    }
  ],
  "bundled": true
}