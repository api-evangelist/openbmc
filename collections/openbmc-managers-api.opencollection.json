{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenBMC Redfish AccountService Managers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Managers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List manager objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{bmc}/redfish/v1/Managers"
          },
          "docs": "List manager objects"
        },
        {
          "info": {
            "name": "Reboot the BMC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{bmc}/redfish/v1/Managers/bmc/Actions/Manager.Reset",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Reboot the BMC"
        },
        {
          "info": {
            "name": "Factory reset the BMC",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{bmc}/redfish/v1/Managers/bmc/Actions/Manager.ResetToDefaults",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Factory reset the BMC"
        }
      ]
    }
  ],
  "bundled": true
}